{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unlocktr",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/oyun",
      "/oyun/*",
      "/game",
      "/game.html",
      "/sitemap.xml",
      "/sitemaps/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "PUBLIC_API_URL": "https://unlocktr-backend.vercel.app/api"
  }
}
